{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omnisx",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "pleiad.io", "custom_domain": true },
    { "pattern": "www.pleiad.io", "custom_domain": true }
  ],
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "omnisx"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      // Placeholder — replace with the id printed by:
      //   npx wrangler kv namespace create RATE_LIMIT_KV
      "id": "a57499088e054890b17bec5d8a0b73ce"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Pools connections to Supabase (Sydney) at Cloudflare's edge; query
      // caching is disabled on the config — tenant isolation relies on query
      // params because the app bypasses RLS as table owner.
      "id": "061219db530c4256ab021a009048f802"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "omnisx-next-cache"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // DB is pinned to ap-southeast-2 (Sydney) — let Cloudflare run the Worker
  // near it so multi-query routes pay one user↔worker round trip instead of
  // one per query. Static assets still serve from the edge ahead of the Worker.
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://pleiad.io"
  }
}
