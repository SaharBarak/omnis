{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omnisx-cron",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": {
    // Schedules MUST match the keys in src/index.ts CRON_ROUTES.
    // send-notifications runs hourly (#65): per-user digest hour × timezone.
    "crons": ["0 6 * * *", "0 4 * * *", "0 * * * *", "0 7 * * *"]
  },
  "vars": {
    "SITE_URL": "https://pleiad.io"
  }
}
