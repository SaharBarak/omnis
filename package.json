{
  "name": "omnis",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/api-client",
    "packages/engine",
    "packages/mobile"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "NEXT_PUBLIC_SITE_URL=https://pleiad.io APP_BASE_URL=https://pleiad.io opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy:cron": "wrangler deploy --config workers/cron/wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest:knowledge": "npx tsx packages/scraper/src/ingest.ts",
    "ingest:knowledge:dry-run": "npx tsx packages/scraper/src/ingest.ts --dry-run",
    "ingest:knowledge:verify": "npx tsx packages/scraper/src/verify.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.24.0",
    "@google/genai": "^2.8.0",
    "@next/third-parties": "^16.1.6",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.182.0",
    "@xyflow/react": "^12.10.0",
    "cheerio": "^1.2.0",
    "circular-natal-horoscope-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.33.0",
    "groq-sdk": "^1.3.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "node-fetch": "^3.3.2",
    "postgres": "^3.4.9",
    "posthog-js": "^1.398.0",
    "react": "^18",
    "react-dom": "^18",
    "react-force-graph-2d": "^1.29.0",
    "resend": "^6.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260612.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^27.4.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.0.17",
    "wrangler": "^4.100.0"
  }
}
