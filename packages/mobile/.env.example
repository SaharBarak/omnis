# Pleiad mobile — public runtime configuration.
# Copy to .env (git-ignored). All EXPO_PUBLIC_* values are inlined into the
# JS bundle at build time — never put secrets here.
#
# .env is gitignored and there is no .easignore, so EAS cloud builds never
# receive it. The same values must exist as EAS environment variables:
#
#   cd packages/mobile && npm run env:push
#
# scripts/assert-env.mjs runs on every cloud build (eas-build-pre-install) and
# fails the build when a required var is unset. iOS builds 9 and 10 shipped
# without these and crashed on launch before first paint.

# --- Required -------------------------------------------------------------

# Supabase project URL, e.g. https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Public by design.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional -------------------------------------------------------------

# Pleiad API origin. Defaults to the production worker when unset.
EXPO_PUBLIC_API_URL=https://pleiad.io

# RevenueCat public SDK keys — paid plans are in-app purchases and the App
# Store / Google Play are the merchant of record. Public by design (the secret
# key is server-side only). Real purchases need a development/EAS build; in
# Expo Go the SDK falls back to Preview API Mode (mocked natives, UI only).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# The single address allowed to sign in with a password, for App Store review.
# Apple's reviewer cannot receive an emailed one-time code. Unset (the default)
# means every account is one-time-code only and the password field never
# renders. Provision the account with scripts/create-review-account.mjs; clear
# this var to retire it.
EXPO_PUBLIC_REVIEW_EMAIL=
