# Pleiad mobile — public runtime configuration.
# Copy to .env (git-ignored). All EXPO_PUBLIC_* values are inlined into the
# JS bundle at build time — never put secrets here.

# Auth0 tenant domain (no scheme), e.g. pleiad.eu.auth0.com
EXPO_PUBLIC_AUTH0_DOMAIN=

# Auth0 *Native* application client id (PKCE — no client secret involved).
# The app's callback URL pleiad:///* (and the Expo Go exp:// redirect during
# development) must be allow-listed on this application.
EXPO_PUBLIC_AUTH0_CLIENT_ID=

# Auth0 API audience — the API identifier the Pleiad server verifies
# (AUTH-M1 bearer auth).
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Pleiad API origin. Defaults to the production worker when unset.
EXPO_PUBLIC_API_URL=https://pleiad.io

# TestFlight-only escape hatch (F11): set to 1 to let iOS builds use the
# hosted-checkout path. Production iOS ships WITHOUT this — the paywall
# follows the App Store reader pattern (copy the web pricing link).
EXPO_PUBLIC_IOS_CHECKOUT=
