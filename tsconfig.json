{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@pleiad/engine": [
        "./packages/engine/src/index.ts"
      ],
      "@pleiad/engine/*": [
        "./packages/engine/src/*"
      ],
      "@pleiad/api-client": [
        "./packages/api-client/src/index.ts"
      ],
      "@pleiad/api-client/*": [
        "./packages/api-client/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    ".open-next",
    "backup-mvp",
    "next-app",
    "node_modules",
    "packages/*/node_modules",
    "packages/mobile",
    "packages/scraper",
    "scripts",
    "src-mvp",
    "workers"
  ]
}