# ===========================================
# Omnis Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!
# ===========================================

# -----------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key - safe for browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key - SERVER ONLY, never expose to browser
# Used for admin operations (cron jobs, server-side data access)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------
# Site Configuration (Required)
# -----------------------------------------

# Your site's public URL (no trailing slash)
# Used for generating links in emails and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------
# Cron Job Security (Required for production)
# -----------------------------------------

# Secret token for authenticating cron job requests
# Generate a secure random string: openssl rand -hex 32
# Vercel automatically sends this in cron requests
CRON_SECRET=your-secure-random-string-here

# -----------------------------------------
# Email Service - Resend (Required)
# -----------------------------------------
# Get your API key from: https://resend.com/api-keys

# Resend API key for sending transactional emails
# Used for: daily Kin emails, newsletter, notifications
RESEND_API_KEY=re_your_api_key_here

# -----------------------------------------
# AI Service - Anthropic (Required)
# -----------------------------------------
# Get your API key from: https://console.anthropic.com/

# Anthropic API key for Claude AI interpretations
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# -----------------------------------------
# AI Configuration (Optional)
# -----------------------------------------

# Claude model to use for interpretations
# Default: claude-3-5-sonnet-20241022
# AI_MODEL=claude-3-5-sonnet-20241022

# Maximum tokens for AI responses
# Default: 1024
# AI_MAX_TOKENS=1024
