# ===========================================
# Pleiad Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!
# ===========================================

# -----------------------------------------
# Supabase Postgres (Required)
# -----------------------------------------
# Pooler URI (Supavisor, port 6543) for the app; pgvector extension required
# (knowledge search). Runtime client uses prepare:false for transaction mode.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — used by drizzle-kit for migrations only.
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# -----------------------------------------
# Auth0 (Required)
# -----------------------------------------
# Regular Web Application in the Auth0 dashboard.
# Allowed Callback URLs: {BASE_URL}/auth/callback
# Allowed Logout URLs:   {BASE_URL}
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Session cookie encryption secret: openssl rand -hex 32
AUTH0_SECRET=
# API audience for native (mobile) bearer tokens — an "API" in the Auth0
# dashboard (e.g. https://api.pleiad.app). Unset = bearer auth disabled.
AUTH0_API_AUDIENCE=
# Public base URL of the app (used for OAuth callbacks).
APP_BASE_URL=http://localhost:3000

# -----------------------------------------
# Site Configuration (Required)
# -----------------------------------------

# Your site's public URL (no trailing slash)
# Used for generating links in emails and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Web Analytics beacon token (optional; enables analytics on CF)
# Dashboard: Cloudflare > Web Analytics > your site > JS snippet token
NEXT_PUBLIC_CF_BEACON_TOKEN=

# PostHog product analytics (optional; analytics fully disabled when unset)
# Create a project at https://us.posthog.com (EU: https://eu.posthog.com),
# then copy the project API key (phc_...). See src/lib/analytics/posthog.ts
# for the funnel definition to build in the PostHog UI.
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud: https://us.i.posthog.com | EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to 1 to also capture events from `next dev` (off by default)
NEXT_PUBLIC_POSTHOG_DEV=

# -----------------------------------------
# Cron Job Security (Required for production)
# -----------------------------------------

# Secret token for authenticating cron job requests
# Generate a secure random string: openssl rand -hex 32
# Vercel automatically sends this in cron requests
CRON_SECRET=your-secure-random-string-here

# -----------------------------------------
# Email Service - Resend (Required)
# -----------------------------------------
# Get your API key from: https://resend.com/api-keys

# Resend API key for sending transactional emails
# Used for: daily Kin emails, newsletter, notifications
RESEND_API_KEY=re_your_api_key_here

# Resend Audience the newsletter mirrors subscribers into (managed list +
# Broadcasts). Create one in the Resend dashboard or via the API; leave empty
# to keep the newsletter DB-only (audience sync no-ops).
RESEND_AUDIENCE_ID=

# Optional: point bulk/marketing mail at a verified marketing subdomain
# (e.g. "Pleiad <hello@updates.pleiad.io>"). Defaults to EMAIL_FROM.
EMAIL_FROM_MARKETING=

# -----------------------------------------
# AI Service - LLM provider (Required for AI interpretations)
# -----------------------------------------
# Default provider is Groq (free tier, privacy-safe: not retained/trained on).
# Get a free key (no card) from: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_api_key_here

# Fallback provider. Set LLM_PROVIDER=gemini to use it.
# NOTE: Gemini's FREE tier trains on your prompts — only use a PAID key for
# real user data. Key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------
# AI Configuration (Optional)
# -----------------------------------------

# Override the model for the active provider.
# Groq default: llama-3.3-70b-versatile · Gemini default: gemini-2.5-flash
# LLM_MODEL=llama-3.3-70b-versatile

# Maximum output tokens for AI responses
# Default: 1000
# AI_MAX_TOKENS=1000

# -----------------------------------------
# Paddle Billing (Required for paid features)
# -----------------------------------------
# ---------------------------------------------------------------------------
# Billing — App Store / Google Play in-app purchases via RevenueCat.
# The stores are the merchant of record (they handle payment + global tax).
# RevenueCat is the entitlement ledger; its app_user_id IS the Auth0 sub, which
# is what lets a purchase made on a phone unlock the same account on the web.
# ---------------------------------------------------------------------------

# Provider selector (only 'revenuecat' today).
BILLING_PROVIDER=revenuecat

# RevenueCat REST key (SERVER ONLY, never expose to the browser).
REVENUECAT_SECRET_KEY=

# The exact Authorization header value configured on the RevenueCat webhook.
# Fails closed: if unset, every webhook is rejected.
REVENUECAT_WEBHOOK_SECRET=

# App Store / Play product identifiers backing each tier (informational —
# plan resolution keys off the RevenueCat entitlement id, which is the tier name).
STORE_PRODUCT_EXPLORER=pleiad_explorer_monthly
STORE_PRODUCT_COMPLETE=pleiad_complete_monthly
STORE_PRODUCT_PRACTITIONER=pleiad_practitioner_monthly
STORE_PRODUCT_LIFETIME=pleiad_founding_lifetime

# Public store listings (upgrade CTAs render "coming soon" until these are set).
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Cloudflare Turnstile (bot protection; optional — everything no-ops if unset).
# Create at Cloudflare dashboard → Turnstile → Add site
# (domains: pleiad.io, www.pleiad.io, localhost), then set the site key here /
# in CI and push the secret to the Worker:
#   npx wrangler secret put TURNSTILE_SECRET_KEY
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
