# ===========================================
# Omnis Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!
# ===========================================

# -----------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key - safe for browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key - SERVER ONLY, never expose to browser
# Used for admin operations (cron jobs, server-side data access)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------
# Site Configuration (Required)
# -----------------------------------------

# Your site's public URL (no trailing slash)
# Used for generating links in emails and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Web Analytics beacon token (optional; enables analytics on CF)
# Dashboard: Cloudflare > Web Analytics > your site > JS snippet token
NEXT_PUBLIC_CF_BEACON_TOKEN=

# -----------------------------------------
# Cron Job Security (Required for production)
# -----------------------------------------

# Secret token for authenticating cron job requests
# Generate a secure random string: openssl rand -hex 32
# Vercel automatically sends this in cron requests
CRON_SECRET=your-secure-random-string-here

# -----------------------------------------
# Email Service - Resend (Required)
# -----------------------------------------
# Get your API key from: https://resend.com/api-keys

# Resend API key for sending transactional emails
# Used for: daily Kin emails, newsletter, notifications
RESEND_API_KEY=re_your_api_key_here

# -----------------------------------------
# AI Service - Google Gemini (Required)
# -----------------------------------------
# Get your API key from: https://aistudio.google.com/apikey

# Gemini API key for AI interpretations
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------
# AI Configuration (Optional)
# -----------------------------------------

# Gemini model to use for interpretations
# Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Maximum output tokens for AI responses
# Default: 1000
# AI_MAX_TOKENS=1000

# -----------------------------------------
# Stripe Billing (Required for paid features)
# -----------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys

# Stripe publishable key (safe for browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe secret key (SERVER ONLY, never expose to browser)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe webhook secret for verifying webhook signatures
# Get this when setting up webhooks in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for subscription plans
# Create these in Stripe Dashboard > Products
STRIPE_PRICE_COMPLETE_MONTHLY=price_complete_monthly_id
STRIPE_PRICE_PRACTITIONER_MONTHLY=price_practitioner_monthly_id

# Optional: Yearly price IDs (if offering annual billing)
# STRIPE_PRICE_COMPLETE_YEARLY=price_complete_yearly_id
# STRIPE_PRICE_PRACTITIONER_YEARLY=price_practitioner_yearly_id
