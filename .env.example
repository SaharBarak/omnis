# ===========================================
# Omnis Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!
# ===========================================

# -----------------------------------------
# Supabase Postgres (Required)
# -----------------------------------------
# Pooler URI (Supavisor, port 6543) for the app; pgvector extension required
# (knowledge search). Runtime client uses prepare:false for transaction mode.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — used by drizzle-kit for migrations only.
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# -----------------------------------------
# Auth0 (Required)
# -----------------------------------------
# Regular Web Application in the Auth0 dashboard.
# Allowed Callback URLs: {BASE_URL}/auth/callback
# Allowed Logout URLs:   {BASE_URL}
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Session cookie encryption secret: openssl rand -hex 32
AUTH0_SECRET=
# Public base URL of the app (used for OAuth callbacks).
APP_BASE_URL=http://localhost:3000

# -----------------------------------------
# Site Configuration (Required)
# -----------------------------------------

# Your site's public URL (no trailing slash)
# Used for generating links in emails and SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Web Analytics beacon token (optional; enables analytics on CF)
# Dashboard: Cloudflare > Web Analytics > your site > JS snippet token
NEXT_PUBLIC_CF_BEACON_TOKEN=

# -----------------------------------------
# Cron Job Security (Required for production)
# -----------------------------------------

# Secret token for authenticating cron job requests
# Generate a secure random string: openssl rand -hex 32
# Vercel automatically sends this in cron requests
CRON_SECRET=your-secure-random-string-here

# -----------------------------------------
# Email Service - Resend (Required)
# -----------------------------------------
# Get your API key from: https://resend.com/api-keys

# Resend API key for sending transactional emails
# Used for: daily Kin emails, newsletter, notifications
RESEND_API_KEY=re_your_api_key_here

# -----------------------------------------
# AI Service - Google Gemini (Required)
# -----------------------------------------
# Get your API key from: https://aistudio.google.com/apikey

# Gemini API key for AI interpretations
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------
# AI Configuration (Optional)
# -----------------------------------------

# Gemini model to use for interpretations
# Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Maximum output tokens for AI responses
# Default: 1000
# AI_MAX_TOKENS=1000

# -----------------------------------------
# Paddle Billing (Required for paid features)
# -----------------------------------------
# Paddle is the merchant of record. Get credentials from the Paddle dashboard.

# Environment: 'sandbox' (default) or 'production'
PADDLE_ENV=sandbox

# Paddle API key (SERVER ONLY, never expose to browser)
PADDLE_API_KEY=your_paddle_api_key_here

# Paddle webhook secret (Notifications > webhook destination)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret_here

# Client-side token for Paddle.js (safe for browser; only needed for overlay)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Paddle Price IDs for subscription plans (Catalog > Products > Prices)
PADDLE_PRICE_COMPLETE=pri_complete_id
PADDLE_PRICE_PRACTITIONER=pri_practitioner_id
