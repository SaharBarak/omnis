# Production secrets for Pleiad. Copy to .prod.vars (gitignored) and fill.
# Leave the three *_SECRET randoms blank — the script generates them.

# Auth0 (production tenant/app)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Supabase (production project)
DATABASE_URL=
DATABASE_URL_DIRECT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paddle (LIVE — after business verification)
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_COMPLETE=
PADDLE_PRICE_PRACTITIONER=
PADDLE_PRICE_EXPLORER=
PADDLE_PRICE_LIFETIME=

# Email / AI / analytics
RESEND_API_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_DEV=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADzLdSrGCypomHZT
TURNSTILE_SECRET=
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Deploy
NEXT_PUBLIC_SITE_URL=https://pleiad.io
APP_BASE_URL=https://pleiad.io
CLOUDFLARE_API_TOKEN=

# Internal randoms — leave blank, auto-generated:
