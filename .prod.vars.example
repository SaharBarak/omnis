# Production secrets for Pleiad. Copy to .prod.vars (gitignored) and fill.
# Leave the three *_SECRET randoms blank — the script generates them.

# Auth0 (production tenant/app)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Supabase (production project)
DATABASE_URL=
DATABASE_URL_DIRECT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Billing — App Store / Google Play IAP via RevenueCat (stores are the MoR).
BILLING_PROVIDER=revenuecat
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
STORE_PRODUCT_COMPLETE=pleiad_complete_monthly
STORE_PRODUCT_PRACTITIONER=pleiad_practitioner_monthly
STORE_PRODUCT_EXPLORER=pleiad_explorer_monthly
STORE_PRODUCT_LIFETIME=pleiad_founding_lifetime
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Email / AI / analytics
RESEND_API_KEY=
# LLM provider for AI interpretations. Default 'groq' (free tier, privacy-safe:
# not retained/trained on). Set GROQ_API_KEY from console.groq.com (no card).
# Gemini stays a drop-in fallback (LLM_PROVIDER=gemini) for higher volume.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_DEV=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADzLdSrGCypomHZT
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Deploy
NEXT_PUBLIC_SITE_URL=https://pleiad.io
APP_BASE_URL=https://pleiad.io
CLOUDFLARE_API_TOKEN=

# Internal randoms — leave blank, auto-generated:
CRON_SECRET=
UNSUBSCRIBE_SECRET=
